<?xml version="1.0" encoding="utf-8"?>
<!--
    Réglages — navigation liste/détail.

    L'écran était une seule colonne de cartes dans un ScrollView : il fallait faire
    défiler avant même de savoir ce qu'il contenait. Le rail de gauche tient les quatre
    catégories, toujours visibles, et le volet de droite n'en montre qu'une.

    Les identifiants sont inchangés : SettingsFragment lie les mêmes vues.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/settings_rail"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rail_settings_language"
            style="@style/Widget.MG4.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:gravity="center_vertical|start"
            android:text="@string/settings_cat_language"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/mg4_corner" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rail_settings_display"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:gravity="center_vertical|start"
            android:text="@string/settings_cat_display"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/mg4_corner" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rail_settings_vehicle"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:gravity="center_vertical|start"
            android:text="@string/settings_cat_vehicle"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/mg4_corner" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rail_settings_app"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:gravity="center_vertical|start"
            android:text="@string/settings_cat_app"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/mg4_corner" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dash_border" />

        <ViewFlipper
            android:id="@+id/settings_detail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

        <ScrollView
            android:id="@+id/page_settings_language"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

            <!-- ── Section LANGUE ──────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_fr"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_language_fr"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_en"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_language_en"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_de"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/settings_language_de"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_es"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_language_es"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_pt"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_language_pt"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_it"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/settings_language_it"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                </LinearLayout>

            </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>
        <ScrollView
            android:id="@+id/page_settings_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_sm">

            <!-- ── Section ÉCRAN PAR DÉFAUT ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_default_screen"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_default_dashboard"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_default_screen_dashboard"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_default_profiles"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/nav_profiles"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_default_shortcuts"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/nav_shortcuts"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                </LinearLayout>

            </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

            <!-- ── Section APPARENCE ────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_auto"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_theme_auto"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_dark"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:text="@string/settings_theme_dark"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner"
                        app:icon="@android:drawable/ic_menu_month"
                        app:iconTint="@color/dash_text_lo"
                        app:iconSize="16dp"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_light"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/settings_theme_light"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label"
                        app:backgroundTint="@color/dash_btn"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_border"
                        app:cornerRadius="@dimen/mg4_corner"
                        app:icon="@android:drawable/ic_menu_today"
                        app:iconTint="@color/dash_text_lo"
                        app:iconSize="16dp"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>
        <ScrollView
            android:id="@+id/page_settings_vehicle"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

            <!-- ── Section RÉGLAGES SUPPLÉMENTAIRES ───────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_auto_apply"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_auto_apply_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <Switch
                        android:id="@+id/switch_auto_apply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:id="@+id/row_auto_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_auto_update_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <Switch
                        android:id="@+id/switch_auto_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

                <!-- ── Alimentation véhicule (SWI133) — éteint la voiture, garde l'écran ── -->
                <View
                    android:id="@+id/row_vehicle_power_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:id="@+id/row_vehicle_power"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_vehicle_power_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vehicle_power_off"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_vehicle_power_btn"
                        android:textColor="@color/dash_accent"
                        android:textSize="@dimen/text_label"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        app:backgroundTint="@color/dash_accent_dim"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/dash_accent"
                        app:cornerRadius="@dimen/mg4_corner" />

                </LinearLayout>

                <!-- ── Sécurité conduite : verrou d'écriture par vitesse ─────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/dash_border" />

                <LinearLayout
                    android:id="@+id/row_speed_gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_speed_gate_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <Switch
                        android:id="@+id/switch_speed_gate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_speed_gate_max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_speed_gate_max_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <EditText
                        android:id="@+id/input_speed_gate_max"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:gravity="end"
                        android:hint="@string/settings_speed_gate_max_hint"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_label"
                        android:imeOptions="actionDone" />

                </LinearLayout>

            </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>
        <ScrollView
            android:id="@+id/page_settings_app"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_sm">

            <!-- ── Boutons MAJ (2 colonnes : Vérifier | Nettoyer) ──────────── -->
            <LinearLayout
                android:id="@+id/row_update_buttons"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_check_update"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/btn_check_update"
                    android:textColor="@color/dash_accent"
                    android:textSize="@dimen/text_label"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_accent_dim"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_accent"
                    app:cornerRadius="@dimen/mg4_corner"
                    app:icon="@android:drawable/stat_sys_download"
                    app:iconTint="@color/dash_accent"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clean_apk"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/btn_clean_apk"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="@dimen/mg4_corner"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@color/dash_text_lo"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <!-- ── Bouton DIAGNOSTIC (caché — 5 clics sur "Vérifier les mises à jour") ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_diagnostic"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:text="@string/btn_diagnostic"
                android:textColor="@color/dash_warn"
                android:textSize="@dimen/text_label"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_warn_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_warn"
                app:cornerRadius="@dimen/mg4_corner"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconTint="@color/dash_warn"
                app:iconGravity="textStart" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

            <!-- ── Bouton INFOS ──────────────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_infos"
