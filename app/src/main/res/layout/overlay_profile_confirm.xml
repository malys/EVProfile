<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmation of applying a profile — full screen window.

    It was a floating map centered on a dark veil. EVSuite asks for a window
    full screen for important confirmation, and this is written in the vehicle:
    the panel therefore fills the screen and the two actions are grouped at the top right,
    where the gaze returns. The countdown remains to the left of the same row.

    The confirm_backdrop identifier remains on the root: ProfileConfirmOverlay hangs on it
    cancellation. The clickable panel covers the entire surface and consumes the supports,
    de sorte qu'un appui n'annule plus par accident.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirm_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/ev_background"
        android:padding="@dimen/spacing_lg"
        android:clickable="true"
        android:focusable="true">

        <!-- Grouped actions at top right; countdown left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/confirm_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/dash_text_lo"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn_no"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:minWidth="220dp"
                android:text="@string/automation_confirm_no"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="@dimen/ev_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn_yes"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:minWidth="220dp"
                android:text="@string/automation_confirm_yes"
                android:textColor="@color/dash_accent"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_accent_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_accent"
                app:cornerRadius="@dimen/ev_corner" />

        </LinearLayout>

        <!-- Message: only content of the window, readable at a glance -->
        <TextView
            android:id="@+id/confirm_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_confirm_message"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_lg"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

</FrameLayout>
