<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirm_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mg4_scrim"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="40dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingHorizontal="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Message encadré -->
        <TextView
            android:id="@+id/confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_confirm_message"
            android:paddingHorizontal="24dp"
            android:paddingVertical="22dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Gros boutons OUI (gauche) / NON (droite) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn_yes"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/automation_confirm_yes"
                android:textColor="@color/dash_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_accent_dim"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_accent"
                app:cornerRadius="@dimen/mg4_corner" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn_no"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/automation_confirm_no"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="@dimen/mg4_corner" />

        </LinearLayout>

        <!-- Timer (bas gauche) -->
        <TextView
            android:id="@+id/confirm_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/dash_text_lo"
            android:textSize="@dimen/text_label" />

    </LinearLayout>

</FrameLayout>
