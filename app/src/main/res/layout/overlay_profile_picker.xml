<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay affiché au-dessus du launcher MG quand l'utilisateur déclenche
    le raccourci "Sélecteur de profil" via le volant.
    Le fond semi-transparent capte les appuis en dehors de la carte pour la fermer.
    Les boutons de profil sont ajoutés en grille 2 colonnes dans ProfilePickerOverlay.kt.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Carte centrale — pleine largeur avec marges latérales -->
    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginHorizontal="60dp"
        android:layout_marginVertical="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_profile_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- ☀ Luminosité (en haut) — masqué si le firmware ne supporte pas le contrôle -->
        <LinearLayout
            android:id="@+id/overlay_brightness_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_brightness_title"
                android:textColor="@color/dash_text_lo"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <!-- 3 presets : Nuit / Moyen / Jour (gros boutons, faciles à viser) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_night"
                    style="@style/Widget.MG4.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="@string/overlay_brightness_night"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_mid"
                    style="@style/Widget.MG4.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                    android:text="@string/overlay_brightness_mid"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_day"
                    style="@style/Widget.MG4.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="@string/overlay_brightness_day"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="10dp" />

            </LinearLayout>

            <!-- Curseur (gros pouce + piste épaisse, réglable en conduisant) + % -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/overlay_bri_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="5"
                    android:valueTo="100"
                    android:value="50"
                    android:stepSize="1"
                    app:labelBehavior="gone"
                    app:thumbRadius="16dp"
                    app:trackHeight="12dp"
                    app:thumbColor="@color/dash_accent"
                    app:trackColorActive="@color/dash_accent"
                    app:trackColorInactive="@color/dash_border" />

                <TextView
                    android:id="@+id/overlay_bri_value"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="end"
                    android:text="--%"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_border"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- Liste de profils défilante (prend l'espace restant entre luminosité et bas) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <!-- Conteneur grille 2 colonnes (rempli dynamiquement) -->
            <LinearLayout
                android:id="@+id/overlay_profiles_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Ligne bas : bouton Fermer + compte à rebours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Zone gauche (poids 1) : FERMER + compte à rebours -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/nav_close"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@color/dash_text_lo"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/overlay_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Centre : bouton Éteindre la voiture (gated firmware dans le code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_btn_poweroff"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/shortcuts_action_vehicle_power_off"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/dash_text_lo"
                app:iconGravity="textStart" />

            <!-- Zone droite (poids 1) : bouton Ouvrir MG4Control (équilibre aussi le centre) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_btn_open_app"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/overlay_open_app"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
