<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay displayed above the MG launcher when the user triggers
    the “Profile Selector” shortcut via the steering wheel.
    The semi-transparent background captures presses outside the card to close it.
    Profile buttons are added in a 2-column grid in ProfilePickerOverlay.kt.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_scrim"
    android:clickable="true"
    android:focusable="true">

    <!-- Center card — full width with side margins -->
    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginHorizontal="60dp"
        android:layout_marginVertical="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_profile_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- ☀ Brightness (top) — hidden if firmware does not support control -->
        <LinearLayout
            android:id="@+id/overlay_brightness_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_brightness_title"
                android:textColor="@color/dash_text_lo"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <!-- 3 presets: Night / Medium / Day (large buttons, easy to aim) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_night"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/overlay_brightness_night"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="@dimen/ev_corner" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_mid"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm" android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/overlay_brightness_mid"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="@dimen/ev_corner" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_bri_day"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/overlay_brightness_day"
                    android:textColor="@color/text_secondary" android:textSize="18sp" android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn" app:strokeColor="@color/dash_border" app:strokeWidth="1dp" app:cornerRadius="@dimen/ev_corner" />

            </LinearLayout>

            <!-- Slider (big thumb + thick track, adjustable while driving) + % -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/overlay_bri_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="5"
                    android:valueTo="100"
                    android:value="50"
                    android:stepSize="1"
                    app:labelBehavior="gone"
                    app:thumbRadius="16dp"
                    app:trackHeight="12dp"
                    app:thumbColor="@color/dash_accent"
                    app:trackColorActive="@color/dash_accent"
                    app:trackColorInactive="@color/dash_border" />

                <TextView
                    android:id="@+id/overlay_bri_value"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="end"
                    android:text="--%"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dash_border"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- Scrolling profile list (takes the remaining space between brightness and low) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <!-- Conteneur grille 2 colonnes (rempli dynamiquement) -->
            <LinearLayout
                android:id="@+id/overlay_profiles_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dash_border"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Bottom line: Close button + countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left zone (weight 1): CLOSE + countdown -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/nav_close"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="@dimen/ev_corner"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@color/dash_text_lo"
                    app:iconGravity="textStart" />

                <TextView
                    android:id="@+id/overlay_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label" />

            </LinearLayout>

            <!-- Center: Turn off car button (gated firmware in code) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlay_btn_poweroff"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/shortcuts_action_vehicle_power_off"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                android:textAllCaps="true"
                app:backgroundTint="@color/dash_btn"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dash_border"
                app:cornerRadius="@dimen/ev_corner"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/dash_text_lo"
                app:iconGravity="textStart" />

            <!-- Right zone (weight 1): Open EVProfile button (also balances the center) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlay_btn_open_app"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/overlay_open_app"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label"
                    android:textAllCaps="true"
                    app:backgroundTint="@color/dash_btn"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/dash_border"
                    app:cornerRadius="@dimen/ev_corner" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
