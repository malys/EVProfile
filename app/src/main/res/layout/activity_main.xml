<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal de l'activité.
    Remplace la BottomNavigationView par une top-bar fixe avec :
      • Logo "MG4Control"
      • Onglets du dashboard (Conduite / ELK), masqués hors dashboard
      • Bouton PROFILS
      • Bouton RÉGLAGES
    La zone de contenu en dessous est gérée par le NavController.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg">

    <!-- ── TOP BAR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:background="@color/mg4_surface">

        <!-- Logo image -->
        <ImageView
            android:id="@+id/topbar_logo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/logo_topbar"
            android:background="@color/mg4_surface"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name" />

        <!-- Destinations du dashboard. Elles vivaient dans une rangée à elles sous la
             barre : 72 dp de boutons plus 32 dp de marges, sur un panneau qui en fait
             720. Ici elles ne coûtent plus de hauteur, et MainActivity ne les montre que
             sur le dashboard — ailleurs elles ne désignent rien. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_controls"
            style="@style/Widget.MG4.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/tab_dashboard_main"
            android:textAllCaps="false"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            app:cornerRadius="@dimen/mg4_corner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_elk"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:text="@string/tab_dashboard_elk"
            android:textAllCaps="false"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton AUDIO (A9 uniquement — masqué par le code sur les autres firmwares) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_audio"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_audio"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton RACCOURCIS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_shortcuts"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton PROFILS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_profiles"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_profiles"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton RÉGLAGES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_settings"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

    </LinearLayout>

    <!-- ── ZONE DE CONTENU (NavController) ────────────────────────── -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</LinearLayout>
