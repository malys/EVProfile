<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal de l'activité : une top-bar fixe au-dessus d'un ViewPager2 unique.

    Tous les écrans — Conduite, ELK, Audio, Profils, Raccourcis, Réglages — sont des pages
    du même pager, dans l'ordre de la barre du haut. Chaque bouton de la barre amène à sa
    page, et le balayage horizontal les parcourt toutes : le geste et le bouton désignent
    la même chose, ce qui rend le bouton « Fermer » de chaque écran inutile (il n'existe
    plus de sous-écran d'où revenir).

    Automatisation (MG4Tasker) n'est pas un écran : c'est un raccourci vers une autre
    application, rangé dans Réglages plutôt que dans cette barre de pages.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg">

    <!-- ── TOP BAR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:background="@color/mg4_surface">

        <!-- Logo image -->
        <ImageView
            android:id="@+id/topbar_logo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/logo_topbar"
            android:background="@color/mg4_surface"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name" />

        <!-- Destinations du dashboard. Elles vivaient dans une rangée à elles sous la
             barre : 72 dp de boutons plus 32 dp de marges, sur un panneau qui en fait
             720. Ici elles ne coûtent plus de hauteur, et comme tous les écrans sont des
             pages du même pager, elles restent affichées partout : ce sont deux
             destinations parmi les six, pas un sous-menu du dashboard. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_controls"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="8dp"
            android:text="@string/tab_dashboard_main"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_elk"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:text="@string/tab_dashboard_elk"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton AUDIO (A9 uniquement — masqué par le code sur les autres firmwares) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_audio"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_audio"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton PROFILS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_profiles"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_profiles"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton RACCOURCIS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_shortcuts"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            android:layout_marginEnd="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

        <!-- Bouton RÉGLAGES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/nav_settings"
            android:textSize="@dimen/text_label"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/dash_btn"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dash_border"
            app:cornerRadius="@dimen/mg4_corner" />

    </LinearLayout>

    <!-- ── ZONE DE CONTENU (pager de tous les écrans) ────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
