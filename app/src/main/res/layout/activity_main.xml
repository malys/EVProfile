<?xml version="1.0" encoding="utf-8"?>
<!--
    Main layout of the activity: a fixed top-bar above a single ViewPager2.

    All screens — Driving, ELK, Audio, Profiles, Shortcuts, Settings — are pages
    of the same pager, in the order of the top bar. Each button on the bar leads to its
    page, and the horizontal swipe goes through them all: the gesture and the button designate
    the same thing, which makes the “Close” button on each screen useless (there is no
    no more subscreen to return from).

    Automation (EVTasker) is not a screen: it is a shortcut to another
    application, stored in Settings rather than in this page bar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg">

    <!-- ── TOP BAR ─────────────────────────────────────────────────────────────────
         The logotype sits on the left, followed by one tab per pager page.

         Tabs share the remaining width equally (weight 1) instead of fitting their text.
         A regular grid can be targeted from memory and keeps every translated label on
         screen across panel densities.

         Tabs sit directly in the bar without an intermediate row: one weight level and
         therefore only one additional measurement pass.

         The active tab draws itself through res/color/nav_tab_*.xml; code sets only
         isSelected. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:background="@drawable/bg_topbar">

        <!-- Text logotype instead of an image. Two token-based TextViews follow the theme
             and stay sharp at every density.

             Five taps unlock Diagnostic (setupDiagnosticUnlock), so the container owns
             the click and therefore the id. -->
        <LinearLayout
            android:id="@+id/topbar_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:orientation="horizontal"
            android:contentDescription="@string/app_name"
            android:importantForAccessibility="yes">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_ev"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="@color/ev_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/brand_profile"
                android:textSize="@dimen/text_title"
                android:textColor="@color/ev_text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_controls"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/tab_dashboard_main"
            app:icon="@drawable/ic_tab_drive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_tab_elk"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/tab_dashboard_elk"
            app:icon="@drawable/ic_tab_lane" />

        <!-- AUDIO tab (A9 only — hidden by code on other firmware). When hidden, its
             weight is returned to the other five tabs. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_audio"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/nav_audio"
            app:icon="@drawable/ic_tab_audio" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_profiles"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/nav_profiles"
            app:icon="@drawable/ic_tab_profiles" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_shortcuts"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/nav_shortcuts"
            app:icon="@drawable/ic_tab_shortcuts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_settings"
            style="@style/Widget.EV.NavTab"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/nav_settings"
            app:icon="@drawable/ic_tab_settings" />

    </LinearLayout>

    <!-- ── CONTENT AREA (pager of all screens) ────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
