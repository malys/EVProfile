<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen safety warning: all context stays readable at 70 cm. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mg4_background"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fw_unknown_title"
            android:textColor="@color/mg4_error"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fw_detected_badge"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/mg4_error"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="@drawable/bg_section_rounded"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_lg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fw_close_app"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:text="@string/fw_unknown_btn_close"
            android:textColor="@color/mg4_error"
            android:textAllCaps="false"
            app:strokeColor="@color/mg4_error"
            app:cornerRadius="@dimen/mg4_corner"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fw_continue"
            style="@style/Widget.MG4.Button"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:text="@string/fw_unknown_btn_continue"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/mg4_corner" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tv_fw_unknown_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fw_unknown_body"
            android:textColor="@color/mg4_text_primary"
            android:textSize="@dimen/text_body"
            android:lineSpacingMultiplier="1.35" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fw_unknown_hint"
            android:textColor="@color/mg4_text_secondary"
            android:textSize="@dimen/text_secondary"
            android:lineSpacingMultiplier="1.35"
            android:background="@drawable/bg_section_rounded"
            android:padding="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_lg" />

    </LinearLayout>

</LinearLayout>
