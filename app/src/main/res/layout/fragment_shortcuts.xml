<?xml version="1.0" encoding="utf-8"?>
<!--
    Flying shortcuts — list/detail navigation.

    The screen suddenly showed the two ★ buttons, the 1 pedal configuration and up to
    ten ADAS buttons: four subjects without hierarchy on a single surface. The rail of
    left separates them, the right pane only shows one. The global switch remains
    above the rail: it conditions the four shutters, it is not one of them.

    The identifiers are unchanged: ShortcutsFragment links the same views.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:padding="@dimen/spacing_md">

    <!-- ── Toggle activation globale ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shortcuts_enabled_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <Switch
            android:id="@+id/switch_shortcuts_enabled"
            style="@style/Widget.EV.Switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:checked="false" />

    </LinearLayout>

    <!-- ── Main zone (visually disabled if toggle OFF) ───── -->
    <LinearLayout
        android:id="@+id/shortcuts_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/shortcuts_rail"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rail_shortcuts_btn1"
                style="@style/Widget.EV.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical|start"
                android:text="@string/shortcuts_btn1_label"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/ev_corner" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rail_shortcuts_btn2"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical|start"
                android:text="@string/shortcuts_btn2_label"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/ev_corner" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rail_shortcuts_pedal"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical|start"
                android:text="@string/shortcuts_cfg_one_pedal"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/ev_corner" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rail_shortcuts_adas"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:gravity="center_vertical|start"
                android:text="@string/shortcuts_cfg_adas"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/ev_corner" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dash_border" />

        <ViewFlipper
            android:id="@+id/shortcuts_detail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/spacing_md">

            <ScrollView
                android:id="@+id/page_shortcuts_btn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <!-- ── Bouton ★ Gauche ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_btn1_label"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="6dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Appui simple -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="54dp" android:text="@string/shortcuts_press_single" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <Spinner android:id="@+id/spinner_btn1_single" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:popupBackground="@color/bg_card" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" android:layout_marginBottom="8dp" />

                    <!-- Appui long -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="54dp" android:text="@string/shortcuts_press_long" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <Spinner android:id="@+id/spinner_btn1_long" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:popupBackground="@color/bg_card" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

                </LinearLayout>

            </ScrollView>
            <ScrollView
                android:id="@+id/page_shortcuts_btn2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <!-- ── Bouton ★ Droite ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_btn2_label"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="6dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Appui simple -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="54dp" android:text="@string/shortcuts_press_single" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <Spinner android:id="@+id/spinner_btn2_single" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:popupBackground="@color/bg_card" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" android:layout_marginBottom="8dp" />

                    <!-- Appui long -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="54dp" android:text="@string/shortcuts_press_long" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <Spinner android:id="@+id/spinner_btn2_long" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:popupBackground="@color/bg_card" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

                </LinearLayout>

            </ScrollView>
            <ScrollView
                android:id="@+id/page_shortcuts_pedal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <!-- ── Config: 1 Pedal (return regen) ──────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_cfg_one_pedal"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:textAllCaps="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:text="@string/shortcuts_cfg_retour" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sc_fallback_off"      android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/regen_off"           android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sc_fallback_low"      android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/regen_low"           android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sc_fallback_medium"   android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/regen_medium"        android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sc_fallback_high"     android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/regen_high"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/sc_fallback_adaptive" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/regen_adaptive_short" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />

                </LinearLayout>
            </LinearLayout>

                </LinearLayout>

            </ScrollView>
            <ScrollView
                android:id="@+id/page_shortcuts_adas"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

            <!-- ── Config : ADAS ─────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/config_adas_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_cfg_adas"
                    android:textColor="@color/dash_text_lo"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:textAllCaps="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                <!-- SWI133 : Off / Lim. / ACC / ICA -->
                <LinearLayout android:id="@+id/config_adas_swi133" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:text="@string/shortcuts_cfg_mode1" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_0" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_off"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_1" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_limiteur_short" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_2" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_auto"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_3" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_acc"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_4" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_ica"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:text="@string/shortcuts_cfg_mode2" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_0" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_off"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_1" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_limiteur_short" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_2" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_auto"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_3" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_acc"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_4" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_ica"          android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    </LinearLayout>

                </LinearLayout>

                <!-- SWI68 : Off / ACC / TJA -->
                <LinearLayout android:id="@+id/config_adas_swi68" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:text="@string/shortcuts_cfg_mode1" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_s68_off" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_desactiver" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_s68_acc" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_acc"       android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_a_s68_tja" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_tja"       android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dash_border" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="52dp" android:text="@string/shortcuts_cfg_mode2" android:textColor="@color/dash_text_lo" android:textSize="@dimen/text_label" android:letterSpacing="0.06" android:textAllCaps="true" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_s68_off" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_desactiver" android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_s68_acc" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_acc"       android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/sc_adas_b_s68_tja" android:layout_width="0dp" android:layout_height="@dimen/touch_target" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/adas_tja"       android:textColor="@color/text_secondary" android:textSize="@dimen/text_label" app:backgroundTint="@color/bg_button" app:strokeWidth="1dp" app:strokeColor="@color/dash_border" app:cornerRadius="@dimen/ev_corner" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </ViewFlipper>

    </LinearLayout>

