<?xml version="1.0" encoding="utf-8"?>
<!-- Page bar: the surface, plus a 2 dp accent rule at the bottom. Without this net, the
     bar and page touch without visible border as soon as the page has a light background,
     and the row of tabs stops reading like a bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ev_surface" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dash_accent" />
        </shape>
    </item>
</layer-list>
