<?xml version="1.0" encoding="utf-8"?>
<!-- Colours specific to MG4 Control. Shared tokens are in colors.xml (generated by
     tools/sync-tokens.mjs - do not add a local colour there).

     This file does two things:

     1. It redirects the historical names (bg_*, dash_*, text_*) onto the suite tokens.
        MG4 Control has ~730 @color/ references in its layouts; renaming them would have
        been an unreadable diff for no gain. The aliases cost one indirection at build
        time and nothing at runtime, and the palette becomes the suite's. New layouts use
        mg4_* directly - these aliases exist only for what is already there.

     2. It declares the product hues: drive modes, regeneration, and the tinted chip
        backgrounds on the dashboard.

     The fill hues (accent_eco, accent_normal, ...) are identical in light and dark:
     they are saturated blocks carrying a white label, not theme surfaces. They were
     darkened so white clears 7:1 on them - the previous values fell to 3.9:1
     (accent_snow) and 4.5:1 (accent_regen). -->
<resources>

    <!-- Historical aliases -> suite tokens -->
    <color name="bg_dark">@color/mg4_background</color>
    <color name="bg_card">@color/mg4_surface</color>
    <color name="bg_button">@color/mg4_surface_raised</color>
    <color name="bg_button_active">@color/mg4_accent</color>

    <color name="text_primary">@color/mg4_text_primary</color>
    <color name="text_secondary">@color/mg4_text_secondary</color>
    <color name="divider">@color/mg4_outline</color>

    <color name="dash_bg">@color/mg4_background</color>
    <color name="dash_card">@color/mg4_surface</color>
    <color name="dash_section">@color/mg4_background</color>
    <color name="dash_border">@color/mg4_outline</color>
    <color name="dash_btn">@color/mg4_surface_raised</color>
    <color name="dash_text_lo">@color/mg4_text_secondary</color>
    <color name="dash_accent">@color/mg4_accent</color>
    <color name="dash_eco">@color/mg4_ok</color>
    <color name="dash_warn">@color/mg4_warn</color>
    <color name="dash_danger">@color/mg4_error</color>
    <color name="accent_warn">@color/mg4_warn</color>
    <color name="accent_default">@color/mg4_surface_raised</color>

    <!-- Product hues: drive modes and regeneration -->
    <!-- Active button fills, white label (text_active). Identical in both themes. The
         button's text label carries the meaning; the colour doubles it. -->
    <color name="accent_eco">#FF1B5E20</color>     <!-- white 7.9:1 -->
    <color name="accent_normal">#FF0D47A1</color>  <!-- white 8.6:1 -->
    <color name="accent_sport">#FF8E1414</color>   <!-- white 9.3:1 -->
    <color name="accent_snow">#FF0E5D74</color>    <!-- white 7.4:1 -->
    <color name="accent_custom">#FF4A0E6B</color>  <!-- white 13.4:1 -->
    <color name="accent_regen">#FF00565E</color>   <!-- white 8.4:1 -->

    <!-- An active button's label stays white in both themes: its background is a
         saturated product hue, not the accent surface. Do not replace this with
         mg4_on_accent, which is almost black in the dark theme. -->
    <color name="text_active">#FFFFFFFF</color>

    <!-- Overlay scrim. The same veil in both themes: it darkens whatever the launcher
         happens to be showing behind the overlay, which is not our surface. -->
    <color name="mg4_scrim">#99000000</color>

    <!-- QR quiet zone. Deliberately white in both themes: a scanner needs the light
         module colour, so this one does not follow DayNight. -->
    <color name="qr_quiet_zone">#FFFFFFFF</color>

    <!-- Console log levels. The console had its own fixed dark palette; these aliases put
         it back on the suite tokens, so it follows DayNight like every other screen. The
         level name is written out beside the colour - the colour never carries it alone. -->
    <color name="console_error">@color/mg4_error</color>
    <color name="console_warn">@color/mg4_warn</color>
    <color name="console_info">@color/mg4_text_primary</color>
    <color name="console_debug">@color/mg4_text_secondary</color>
    <color name="console_timestamp">@color/mg4_text_secondary</color>
    <color name="console_tag">@color/mg4_accent</color>

    <!-- Tinted chip backgrounds on the dashboard -->
    <!-- Used as the background behind dash_accent / dash_eco / dash_warn / dash_danger
         as text. Each pair clears at least 7:1. See values-night/colors_app.xml. -->
    <color name="dash_accent_dim">#FFD9EDF6</color>
    <color name="dash_eco_dim">#FFE4F7EA</color>
    <color name="dash_warn_dim">#FFFDF1E0</color>
    <color name="dash_danger_dim">#FFFEF1F2</color>
</resources>
