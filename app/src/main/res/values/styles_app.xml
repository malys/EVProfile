<?xml version="1.0" encoding="utf-8"?>
<!-- Styles specific to EVProfile. The shared styles of the suite are in
     styles_ev.xml, generated by tools/sync-tokens.mjs — don't add anything there. -->
<resources>

    <!-- A page bar tab (activity_main.xml).

         Icon above the label rather than next to it: six tabs must fit on the
         width of the panel regardless of its density, and a stacked label has
         the entire width of the tab instead of sharing it with the icon. “Exit from
         lane” is not truncated.

         The icon doubles the label, it does not replace it: a bar of icons alone
         can be guessed, and you can't guess while driving.

         All colors come from selectors on android:state_selected
         (res/color/nav_tab_*.xml): the active tab paints itself, so the code no longer
         than to set isSelected. -->
    <style name="Widget.EV.NavTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingEnd">@dimen/spacing_xs</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nav_tab_foreground</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">@dimen/text_label</item>
        <item name="icon">@null</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">@dimen/spacing_xs</item>
        <item name="iconTint">@color/nav_tab_foreground</item>
        <item name="backgroundTint">@color/nav_tab_background</item>
        <item name="strokeColor">@color/nav_tab_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ev_corner</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
