<?xml version="1.0" encoding="utf-8"?>
<!-- Contour d'un onglet. L'onglet actif n'en a pas besoin — son fond plein le détache
     déjà — mais garder un contour de la même couleur que le fond évite que sa taille
     saute d'un dp au changement de page. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/dash_accent" />
    <item android:color="@color/dash_border" />
</selector>
