<?xml version="1.0" encoding="utf-8"?>
<!-- Fond d'un onglet de la barre de pages. L'état vient de View.isSelected, posé par
     MainActivity.markCurrentPage sur le seul onglet dont la page est à l'écran : la
     couleur n'est plus appliquée à la main dans le code, ce qui garantit qu'un onglet
     ne peut pas rester peint « actif » si la liste des écrans change. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/dash_accent" />
    <item android:color="@color/dash_btn" />
</selector>
