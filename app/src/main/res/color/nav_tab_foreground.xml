<?xml version="1.0" encoding="utf-8"?>
<!-- Text and icon of a tab. On the active tab the background is @color/dash_accent, so
     the foreground is ev_on_accent — white in light theme, almost black in dark theme.
     Both pairs exceed 7:1, the straight floor. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/ev_on_accent" />
    <item android:color="@color/ev_text_primary" />
</selector>
