<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!-- Permissions — same as original DriveHub Dort -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- [T-910] Exigée à partir d'API 34 pour foregroundServiceType="connectedDevice". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Bluetooth profile matching. API 28–30 uses the legacy normal permission;
         API 31+ requires BLUETOOTH_CONNECT. Calls already fail closed on SecurityException. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Vehicle control permissions (Android Automotive / SAIC) -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />

    <!-- [T-902] "com.saic.keyevent.hardkey.report" n'est pas un broadcast protégé :
         n'importe quelle app installée peut le forger et piloter les raccourcis, donc
         écrire mode de conduite / régen / ADAS / AEB. Le receiver exige désormais cette
         permission côté ÉMETTEUR. En protectionLevel="signature", seule une app signée
         avec la clé plateforme de la ROM l'obtient — c'est le cas de l'émetteur système
         d'origine, jamais d'une app tierce. -->
    <permission
        android:name="com.evsuite.profile.permission.RECEIVE_HARDKEY"
        android:protectionLevel="signature" />

    <!-- External control API. In protectionLevel="signature", only an app signed with the
         same platform key can bind ProfileControlService. EVProfile declares the permission
         to protect that service; any such app may list and apply EVProfile profiles. -->
    <permission
        android:name="com.evsuite.profile.permission.CONTROL_PROFILES"
        android:protectionLevel="signature" />

    <!-- Réseau / OTA : déclarés UNIQUEMENT dans le canal unstable
         (src/unstable/AndroidManifest.xml). Stable n'en a aucun, par construction. -->

    <!-- API 30+ : sans ça, EVTasker est invisible pour getLaunchIntentForPackage() et le
         bouton Automatisation resterait masqué sur une voiture où l'app est installée. -->
    <!-- EVTasker, tous canaux confondus. Un testeur qui installe le canal unstable, ou la
         variante offline, a la même app : ne déclarer que l'id stable rendait le bouton
         Automatisation invisible sur ces installations. -->
    <queries>
        <package android:name="com.evsuite.tasker" />
        <package android:name="com.evsuite.tasker.unstable" />
        <package android:name="com.evsuite.tasker.offline" />
        <package android:name="com.evsuite.tasker.offline.unstable" />
    </queries>

    <application
        android:name=".EVApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EVProfile"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <!-- API Car AOSP (CarDoorLockManager pour la détection d'ouverture de porte) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [T-910] foregroundServiceType est OBLIGATOIRE à partir d'API 34 : sans lui,
             startForeground() lève MissingForegroundServiceTypeException. Sans effet sur
             AAOS 9 (API 28), mais le déclarer maintenant évite un crash au premier bump de
             SDK. "connectedDevice" correspond à ce que fait le service : suivre l'état du
             véhicule. -->
        <service
            android:name=".service.EVProfileService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- External control API (profiles). exported=true because the caller is another
             app, but access is closed by the signature permission: only an app signed with
             the ROM platform key can bind. The service exposes no raw property write —
             only listing and applying EVProfile profiles. -->
        <service
            android:name=".api.ProfileControlService"
            android:exported="true"
            android:permission="com.evsuite.profile.permission.CONTROL_PROFILES" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:priority="1000">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
