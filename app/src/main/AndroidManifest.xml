<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!-- Permissions — same as original DriveHub Dort -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- [T-910] Required from API 34 for foregroundServiceType="connectedDevice". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required since API 33 to display foreground service notification,
         only visible sign that EVProfile is running. Without it, it is silently suppressed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Bluetooth profile matching. API 28–30 uses the legacy normal permission;
         API 31+ requires BLUETOOTH_CONNECT. Calls already fail closed on SecurityException. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Vehicle control permissions (Android Automotive / SAIC) -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />

    <!-- [T-902] "com.saic.keyevent.hardkey.report" is not a protected broadcast:
         any installed app can forge it and control the shortcuts, so
         write driving mode / regen / ADAS / AEB. The receiver now requires this
         permission on the TRANSMITTER side. In protectionLevel="signature", only a signed app
         with the platform key of the ROM obtains it — this is the case of the system transmitter
         original, never from a third-party app. -->
    <permission
        android:name="com.evsuite.profile.permission.RECEIVE_HARDKEY"
        android:protectionLevel="signature" />

    <!-- External control API. In protectionLevel="signature", only an app signed with the
         same platform key can bind ProfileControlService. EVProfile declares the permission
         to protect that service; any such app may list and apply EVProfile profiles. -->
    <permission
        android:name="com.evsuite.profile.permission.CONTROL_PROFILES"
        android:protectionLevel="signature" />

    <!-- Network / OTA: declared ONLY in the unstable channel
         (src/unstable/AndroidManifest.xml). Stable has none by construction. -->

    <!-- API 30+: without this, EVTasker is invisible for getLaunchIntentForPackage() and the
         Automation button would remain hidden on a car where the app is installed. -->
    <!-- EVTasker, all channels combined. A tester who installs the unstable channel, or the
         offline variant, has the same app: only declaring the stable id made the button
         Automation would otherwise be invisible on those installations. -->
    <queries>
        <package android:name="com.evsuite.tasker" />
        <package android:name="com.evsuite.tasker.unstable" />
        <package android:name="com.evsuite.tasker.offline" />
        <package android:name="com.evsuite.tasker.offline.unstable" />
    </queries>

    <application
        android:name=".EVApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EVProfile"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <!-- Car API AOSP (CarDoorLockManager for door opening detection) -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [T-910] foregroundServiceType is MANDATORY from API 34: without it,
             startForeground() throws MissingForegroundServiceTypeException. No effect on
             AAOS 9 (API 28), but declaring it now avoids a crash on the first bump of
             SDK. "connectedDevice" corresponds to what the service does: track the state of the
             vehicle. -->
        <service
            android:name=".service.EVProfileService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- External control API (profiles). exported=true because the caller is another
             app, but access is closed by the signature permission: only an app signed with
             the ROM platform key can bind. The service exposes no raw property write —
             only listing and applying EVProfile profiles. -->
        <service
            android:name=".api.ProfileControlService"
            android:exported="true"
            android:permission="com.evsuite.profile.permission.CONTROL_PROFILES" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:priority="1000">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
