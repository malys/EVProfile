# ── Line-ending normalization ────────────────────────────────────────────────
# All text files are normalized to LF in the repository
* text=auto eol=lf

# Fichiers texte explicites
*.kt        text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf
*.pro       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.properties text eol=lf
*.html      text eol=lf

# ── Binary files (no conversion, no text diff) ─────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.apk       binary
*.aab       binary
*.jks       binary
*.keystore  binary
*.jar       binary
*.aar       binary
*.so        binary
*.zip       binary

# ── Gradle Wrapper Scripts — executable on Unix ────────────────────────────
gradlew     text eol=lf
gradlew.bat text eol=crlf
